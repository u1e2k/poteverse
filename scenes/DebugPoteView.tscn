[node name="Margin" type="MarginContainer" parent="SpeciesSelectModalPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="SpeciesSelectModalPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="SpeciesSelectModalPanel/Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="SpeciesSelectModalPanel/Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
text = "🔄 ポテ種族 自由変身 (デバッグ)"

[node name="BtnCloseSpeciesSelect" type="Button" parent="SpeciesSelectModalPanel/Margin/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 32)
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "❌ 閉じる"

[node name="ScrollSpecies" type="ScrollContainer" parent="SpeciesSelectModalPanel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="SpeciesListContainer" type="VBoxContainer" parent="SpeciesSelectModalPanel/Margin/VBox/ScrollSpecies"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

