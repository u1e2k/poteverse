]


# ==============================================================================
# 公開API: テクスチャ生成
# ==============================================================================
static func create_item_texture(item_type: String, fg_color: Color = Color(0.12, 0.16, 0.12, 1.0)) -> ImageTexture:
	var pattern: Array = []
	match item_type:
		"meat": pattern = ITEM_MEAT
		"protein": pattern = ITEM_PROTEIN
		"poop": pattern = ITEM_POOP
		"happy_note": pattern = ICON_HAPPY_NOTE
		"punch": pattern = ITEM_PUNCH
		"blast": pattern = ITEM_BLAST
		_: pattern = ITEM_MEAT
	return _render_pattern_to_texture(pattern, fg_color)


static func create_texture(species_id: String, frame_index: int, is_eating: bool = false, fg_color: Color = Color(0.12, 0.16, 0.12, 1.0)) -> ImageTexture:
	var pattern = _get_pattern_for_species(species_id, frame_index, is_eating)
	return _render_pattern_to_texture(pattern, fg_color)


static func _render_pattern_to_texture(pattern: Array, fg_color: Color) -> ImageTexture:
	var img = Image.create(16, 16, false, Image.FORMAT_RGBA8)
	for y in range(16):
		var row_str: String = pattern[y] if y < pattern.size() else "................"
		for x in range(16):
			var char_code = row_str[x] if x < row_str.length() else "."
			if char_code == "1":
				img.set_pixel(x, y, fg_color)
			elif char_code == "2":
				img.set_pixel(x, y, fg_color.lightened(0.4))
			else:
				img.set_pixel(x, y, Color(0, 0, 0, 0))
	return ImageTexture.create_from_image(img)


static func _get_pattern_for_species(species_id: String, frame_index: int, is_eating: bool) -> Array:
	var f = frame_index % 2

	if is_eating:
		match species_id:
			"baby_drak", "baby_pote": return BABY_DRAK_EAT if f == 0 else BABY_DRAK_F2
			"baby_byte": return BABY_BYTE_EAT if f == 0 else BABY_BYTE_F2
			"baby_fang": return BABY_FANG_EAT if f == 0 else BABY_FANG_F2
			"baby_slime": return BABY_SLIME_EAT if f == 0 else BABY_SLIME_F2

			"child_drak": return DRAK_EAT if f == 0 else DRAK_IDLE_F2
			"child_byte": return BYTE_EAT if f == 0 else BYTE_IDLE_F2
			"child_fang": return FANG_EAT if f == 0 else FANG_IDLE_F2
			"child_slime": return SLIME_EAT if f == 0 else SLIME_IDLE_F2

			"adult_drak", "adult_flame": return FLAME_EAT if f == 0 else FLAME_IDLE_F2
			"adult_byte", "adult_cyber": return CYBER_EAT if f == 0 else CYBER_IDLE_F2
			"adult_fang", "adult_gale": return GALE_EAT if f == 0 else GALE_IDLE_F2
			"adult_slime", "adult_king_slime": return KING_SLIME_EAT if f == 0 else KING_SLIME_IDLE_F2

			"master_drak", "master_wargod": return WARGOD_EAT if f == 0 else WARGOD_IDLE_F2
			"master_byte", "master_omega": return OMEGA_EAT if f == 0 else OMEGA_IDLE_F2
			"master_fang", "master_fenrir": return FENRIR_EAT if f == 0 else FENRIR_IDLE_F2
			"master_slime", "master_cosmic": return COSMIC_EAT if f == 0 else COSMIC_IDLE_F2

			_: return BABY_DRAK_EAT if f == 0 else BABY_DRAK_F2

	match species_id:
		# 0. EGG
		"egg_basic", "egg_pote", "egg_drak": return EGG_DRAK_F1 if f == 0 else EGG_DRAK_F2
		"egg_byte": return EGG_BYTE_F1 if f == 0 else EGG_BYTE_F2
		"egg_fang": return EGG_FANG_F1 if f == 0 else EGG_FANG_F2
		"egg_slime": return EGG_SLIME_F1 if f == 0 else EGG_SLIME_F2

		# 1. BABY
		"baby_drak", "baby_pote": return BABY_DRAK_F1 if f == 0 else BABY_DRAK_F2
		"baby_byte": return BABY_BYTE_F1 if f == 0 else BABY_BYTE_F2
		"baby_fang": return BABY_FANG_F1 if f == 0 else BABY_FANG_F2
		"baby_slime": return BABY_SLIME_F1 if f == 0 else BABY_SLIME_F2

		# 2. CHILD
		"child_drak": return DRAK_IDLE_F1 if f == 0 else DRAK_IDLE_F2
		"child_byte": return BYTE_IDLE_F1 if f == 0 else BYTE_IDLE_F2
		"child_fang": return FANG_IDLE_F1 if f == 0 else FANG_IDLE_F2
		"child_slime": return SLIME_IDLE_F1 if f == 0 else SLIME_IDLE_F2

		# 3. ADULT
		"adult_drak", "adult_flame": return FLAME_IDLE_F1 if f == 0 else FLAME_IDLE_F2
		"adult_byte", "adult_cyber": return CYBER_IDLE_F1 if f == 0 else CYBER_IDLE_F2
		"adult_fang", "adult_gale": return GALE_IDLE_F1 if f == 0 else GALE_IDLE_F2
		"adult_slime", "adult_king_slime": return KING_SLIME_IDLE_F1 if f == 0 else KING_SLIME_IDLE_F2

		# 4. MASTER
		"master_drak", "master_wargod": return WARGOD_IDLE_F1 if f == 0 else WARGOD_IDLE_F2
		"master_byte", "master_omega": return OMEGA_IDLE_F1 if f == 0 else OMEGA_IDLE_F2
		"master_fang", "master_fenrir": return FENRIR_IDLE_F1 if f == 0 else FENRIR_IDLE_F2
		"master_slime", "master_cosmic": return COSMIC_IDLE_F1 if f == 0 else COSMIC_IDLE_F2

		_: return BABY_DRAK_F1 if f == 0 else BABY_DRAK_F2
