; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is present here for immediate project setup.

config_version=5

[application]

config/name="Poteverse"
config/description="ANBERNIC RG Rotate向け スタンドアロン相棒育成ギアゲーム"
config/version="0.1.0"
run/main_scene="res://scenes/DebugPoteView.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PoteDatabase="*res://scripts/data/PoteDatabase.gd"
PoteverseTimeManager="*res://scripts/core/PoteverseTimeManager.gd"
PoteState="*res://scripts/core/PoteState.gd"
PoteCryoStorage="*res://scripts/core/PoteCryoStorage.gd"


[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation=1

